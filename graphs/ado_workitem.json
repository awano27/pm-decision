{
  "name": "workitem-intake",
  "event": "ado.workitem.created",
  "start": "ready",
  "nodes": {
    "ready": {
      "kind": "judge",
      "question": {
        "type": "noul",
        "instructions": "Does the work item state acceptance criteria, an expected result, or steps to reproduce a problem?",
        "hints": [
          "acceptance",
          "受け入れ",
          "再現",
          "repro",
          "期待",
          "expected"
        ]
      },
      "routes": {
        "yes": "priority",
        "no": "request_info",
        "unsure": "priority"
      }
    },
    "request_info": {
      "kind": "decide",
      "actions": [
        {
          "type": "ado.comment",
          "id": "{event.id}",
          "text": "着手に必要な情報が不足しています。受け入れ条件（Bugは再現手順と期待結果）を追記してください。— kimeru"
        },
        {
          "type": "ado.update",
          "id": "{event.id}",
          "fields": {
            "System.Tags": "kimeru;needs-info"
          }
        }
      ]
    },
    "priority": {
      "kind": "judge",
      "question": {
        "type": "score",
        "instructions": "How severe and urgent is this work item for the product?",
        "criteria": [
          "Cosmetic, internal or nice to have; no deadline",
          "Affects customers or a known deadline, but is not blocking anyone today",
          "Customers, production or an upcoming release are blocked or broken right now"
        ],
        "hints": {
          "2": [
            "本番",
            "production",
            "全ユーザー",
            "blocker",
            "ログインできない"
          ],
          "1": [
            "顧客",
            "リリース",
            "改善",
            "improve"
          ]
        }
      },
      "_comment": "ordinal: adjacent-level splits are expected (min_conf low); splits across non-adjacent levels go to a human",
      "min_conf": 0.3,
      "routes": {
        "bands": [
          [
            0.75,
            "set_p3"
          ],
          [
            1.6,
            "set_p2"
          ],
          [
            3,
            "set_p1"
          ]
        ],
        "unsure": "triage_pm"
      },
      "adjacent_only": true
    },
    "set_p1": {
      "kind": "decide",
      "actions": [
        {
          "type": "ado.update",
          "id": "{event.id}",
          "fields": {
            "Microsoft.VSTS.Common.Priority": 1
          }
        }
      ],
      "advice": "P1 を今スプリントに入れるか判断: #{event.id} {event.title}"
    },
    "set_p2": {
      "kind": "decide",
      "actions": [
        {
          "type": "ado.update",
          "id": "{event.id}",
          "fields": {
            "Microsoft.VSTS.Common.Priority": 2
          }
        }
      ]
    },
    "set_p3": {
      "kind": "decide",
      "actions": [
        {
          "type": "ado.update",
          "id": "{event.id}",
          "fields": {
            "Microsoft.VSTS.Common.Priority": 3
          }
        }
      ]
    },
    "triage_pm": {
      "kind": "advise",
      "queue": true,
      "advice": "優先度を判定できないチケット #{event.id} {event.title}"
    }
  }
}
