{
  "name": "alert-triage",
  "event": "monitor.alert",
  "start": "resolved",
  "nodes": {
    "resolved": {
      "kind": "judge",
      "question": {
        "type": "noul",
        "instructions": "Does `condition` indicate the alert has already resolved?",
        "hints": [
          "\"condition\": \"resolved\""
        ]
      },
      "yes_at": 0.8,
      "routes": {
        "yes": "log_resolved",
        "no": "critical_outage",
        "unsure": "critical_outage"
      }
    },
    "impact": {
      "kind": "judge",
      "question": {
        "type": "score",
        "instructions": "Given the alert `rule`, `severity`, `description` and `context`, how large is the customer impact?",
        "criteria": [
          "Nobody is affected (no users, no systems in use)",
          "Only internal staff or internal systems are affected; customers are not",
          "Customers can still use the service but it is degraded or slow",
          "Customers cannot use the service or a core function (pay, sign in, check out)"
        ],
        "hints": {
          "1": [
            "batch",
            "internal",
            "社内"
          ],
          "2": [
            "latency",
            "遅延",
            "5xx",
            "error rate"
          ],
          "3": [
            "down",
            "unavailable",
            "停止",
            "sev0"
          ]
        }
      },
      "min_conf": 0.45,
      "routes": {
        "bands": [
          [
            0.5,
            "noise_check"
          ],
          [
            1.5,
            "task_internal"
          ],
          [
            2.5,
            "bug_p1"
          ],
          [
            4,
            "plan_incident"
          ]
        ],
        "unsure": "page_advice"
      }
    },
    "noise_check": {
      "kind": "judge",
      "question": {
        "type": "noul",
        "instructions": "Does the alert look like a flapping or threshold-noise alert rather than a real fault?",
        "hints": [
          "flapping",
          "threshold",
          "閾値"
        ]
      },
      "routes": {
        "yes": "tune_rule",
        "no": "task_internal",
        "unsure": "task_internal"
      }
    },
    "page": {
      "kind": "decide",
      "actions": [
        {
          "type": "oncall.page",
          "summary": "{event.rule}: {event.description}"
        },
        {
          "type": "teams.post",
          "channel": "incident",
          "text": "[障害] {event.rule} ({event.severity}) {event.description}"
        },
        {
          "type": "ado.create",
          "work_item_type": "Bug",
          "title": "[Incident] {event.rule}",
          "priority": "1",
          "tags": "kimeru;incident"
        }
      ],
      "advice": "顧客影響大。関係者への一次連絡を PM から出すこと"
    },
    "bug_p1": {
      "kind": "decide",
      "actions": [
        {
          "type": "ado.create",
          "work_item_type": "Bug",
          "title": "[Alert] {event.rule}",
          "priority": "1",
          "description": "{event.description}",
          "tags": "kimeru;alert"
        }
      ]
    },
    "task_internal": {
      "kind": "decide",
      "actions": [
        {
          "type": "ado.create",
          "work_item_type": "Task",
          "title": "[Alert] {event.rule}",
          "priority": "3",
          "tags": "kimeru;alert"
        }
      ]
    },
    "tune_rule": {
      "kind": "advise",
      "queue": false,
      "advice": "ノイズの可能性: ルール {event.rule} の閾値見直しを次回定例で提案"
    },
    "log_resolved": {
      "kind": "decide",
      "actions": [
        {
          "type": "log.only"
        }
      ]
    },
    "page_advice": {
      "kind": "advise",
      "queue": true,
      "advice": "影響度が判定できないアラート {event.rule} ({event.severity}): 5分以内に人が確認"
    },
    "plan_incident": {
      "kind": "plan",
      "playbooks": [
        "incident"
      ],
      "routes": {
        "ok": "page_planned",
        "none": "page",
        "unsure": "page"
      }
    },
    "page_planned": {
      "kind": "decide",
      "actions": [
        {
          "type": "oncall.page",
          "summary": "{event.rule}: {event.description}"
        },
        {
          "type": "teams.post",
          "channel": "incident",
          "text": "[障害] {event.rule} ({event.severity}) {event.description}"
        },
        {
          "type": "ado.create",
          "work_item_type": "Bug",
          "title": "[Incident] {event.rule}",
          "priority": "1",
          "tags": "kimeru;incident"
        }
      ],
      "advice": "{plan.title}: {plan.summary}",
      "per_step": [
        {
          "type": "ado.create",
          "work_item_type": "Task",
          "title": "[Incident] {step.title}",
          "due": "{step.due}",
          "tags": "kimeru;incident;plan"
        }
      ]
    },
    "future_risk": {
      "kind": "judge",
      "question": {
        "type": "noul",
        "instructions": "Does the alert warn about a problem expected to happen in the future, rather than a problem happening now?",
        "hints": [
          "expires",
          "expiry",
          "期限切れ",
          "will be full",
          "forecast",
          "予測",
          "見込み"
        ]
      },
      "routes": {
        "yes": "horizon",
        "no": "impact",
        "unsure": "impact"
      }
    },
    "horizon": {
      "kind": "judge",
      "question": {
        "type": "score",
        "instructions": "When is the problem described in the alert expected to happen?",
        "criteria": [
          "Within the next 24 hours",
          "Within the next 7 days",
          "More than 7 days from now"
        ],
        "hints": {
          "0": [
            "hours",
            "時間",
            "today"
          ],
          "1": [
            "days",
            "日以内",
            "this week"
          ],
          "2": [
            "weeks",
            "months",
            "週間",
            "か月"
          ]
        }
      },
      "routes": {
        "bands": [
          [
            0.5,
            "prevent_now"
          ],
          [
            1.5,
            "prevent_week"
          ],
          [
            3,
            "prevent_backlog"
          ]
        ],
        "unsure": "prevent_advice"
      }
    },
    "prevent_now": {
      "kind": "decide",
      "actions": [
        {
          "type": "ado.create",
          "work_item_type": "Task",
          "title": "[予防] {event.rule}",
          "priority": "1",
          "description": "{event.description}",
          "tags": "kimeru;alert;preventive"
        },
        {
          "type": "teams.post",
          "channel": "incident",
          "text": "[予防・24時間以内] {event.rule}: {event.description}"
        }
      ],
      "advice": "24時間以内に起きる見込みの問題: {event.rule}。今日中に担当を決めること"
    },
    "prevent_week": {
      "kind": "decide",
      "actions": [
        {
          "type": "ado.create",
          "work_item_type": "Task",
          "title": "[予防] {event.rule}",
          "priority": "2",
          "description": "{event.description}",
          "tags": "kimeru;alert;preventive"
        }
      ]
    },
    "prevent_backlog": {
      "kind": "decide",
      "actions": [
        {
          "type": "ado.create",
          "work_item_type": "Task",
          "title": "[予防] {event.rule}",
          "priority": "3",
          "description": "{event.description}",
          "tags": "kimeru;alert;preventive"
        }
      ]
    },
    "prevent_advice": {
      "kind": "advise",
      "queue": true,
      "advice": "将来のリスクと判定したが時期が不明なアラート {event.rule}: 対応時期を決めて"
    },
    "critical_outage": {
      "kind": "match",
      "_comment": "safety net: an explicit statement that customers cannot use a core function always pages, whatever the model scores",
      "fields": [
        "description",
        "rule"
      ],
      "patterns": [
        "(customers?|users?)[^.;]{0,40}(cannot|can't|unable to|are unable to)[^.;]{0,20}(pay|check ?out|sign in|log ?in|access|use the service)",
        "(支払|決済|購入|ログイン|サインイン|ログオン)[^。]{0,10}(できない|できません|不可|通らない|失敗)",
        "(all|every) regions?|全(リージョン|ユーザー|拠点)",
        "(完全|全面)?停止中|全停止|サービス停止|service (is )?down|outage"
      ],
      "routes": {
        "yes": "plan_incident",
        "no": "future_risk"
      }
    }
  }
}
